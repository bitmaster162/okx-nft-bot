APP_PROFILE=dev
APP_ENV=dev
PROFILES_DIR=./deploy/profiles

# Main fraud/read-only runtime
DB_PATH=./data/okx_nft_bot.sqlite3
BACKUP_DIR=./data/backups
RULES_PATH=./config/rule_packs.json
REGISTRY_PATH=./config/collections_registry.json
METRICS_PATH=./data/runtime_metrics.json
HEALTH_MAX_STALENESS_SECONDS=300
HEALTH_ALERT_COOLDOWN_SECONDS=900
ACTIVE_MARKET=okx

# OKX source credentials
OKX_API_BASE=https://web3.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_CHAIN=eth
OKX_COLLECTION_ADDRESS=
OKX_COLLECTION_SLUG=
# Map contract addresses to OKX page slugs: addr1=slug1,addr2=slug2
OKX_SLUG_MAP=
OKX_PLATFORM=okx
OKX_PAGE_LIMIT=20
OKX_REQUEST_TIMEOUT=20
OKX_MAX_RETRIES=4
OKX_RATE_LIMIT_PER_SEC=3.0
OKX_ENABLE_DETAILS=false
OKX_MAX_PAGES_PER_RUN=5
OKX_CURSOR_NAMESPACE=default

# OpenSea source
OPENSEA_API_BASE=https://api.opensea.io
OPENSEA_API_KEY=
OPENSEA_COLLECTION_SLUG=
OPENSEA_CHAIN=ethereum
OPENSEA_REQUEST_TIMEOUT=20
OPENSEA_MAX_RETRIES=4
OPENSEA_RATE_LIMIT_PER_SEC=2.0
OPENSEA_PAGE_LIMIT=20
OPENSEA_MAX_PAGES_PER_RUN=5
OPENSEA_CURSOR_NAMESPACE=default

# Magic Eden source
MAGICEDEN_API_BASE=https://api-mainnet.magiceden.dev
MAGICEDEN_API_KEY=
MAGICEDEN_CHAIN=bsc
MAGICEDEN_COLLECTION_ADDRESS=
MAGICEDEN_COLLECTION_SLUG=
MAGICEDEN_REQUEST_TIMEOUT=20
MAGICEDEN_MAX_RETRIES=4
MAGICEDEN_RATE_LIMIT_PER_SEC=2.0
MAGICEDEN_PAGE_LIMIT=20
MAGICEDEN_CURSOR_NAMESPACE=default

COLLECTION_ALLOWLIST=
MIN_PRICE=
MIN_VOLUME=

SCHEDULER_INTERVAL_SECONDS=60
DAEMON_MAX_CYCLES=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_TIMEOUT=10
TELEGRAM_POLL_INTERVAL_SECONDS=5
TELEGRAM_ADMIN_CHAT_IDS=
WEBHOOK_URL=
NOTIFICATION_MODE=passed_only

# Read-only offers / analytics helpers
PARASITE_WALLETS=0x8389a3e684d532a3b0b4cdbb72c9c7797e6fa4f7,0xf1771cf8831393422189330a79dd896223c357a4
OFFERS_DB_PATH=./data/offers.sqlite3
OFFERS_MAX_PAGES_PER_RUN=5
BINANCE_WHITELIST_PATH=./data/binance_whitelist.json
BINANCE_WHITELIST_TIMEOUT_SECONDS=10

# Separate BSC dry-run execution runtime
DRY_RUN=true
EXECUTION_DB_PATH=./data/execution.sqlite3
EXECUTION_CHAIN=bsc
MASS_OFFER_PRICE_BNB=0.01
MASS_OFFER_DURATION_HOURS=24
MASS_OFFER_DELAY_SECONDS=2
MASS_OFFER_MAX_TOTAL=100
MASS_OFFER_DRY_RUN=true

# Required for signer previews / counterbid preview payloads
BUYER_WALLET_ADDRESS=
BUYER_WALLET_PRIVATE_KEY=

# v16 undercutter controls
UNDERCUT_INTERVAL_SECONDS=30
UNDERCUT_MAX_OFFER_AGE_HOURS=24
UNDERCUT_ATTACK_RATIO=0.75
UNDERCUT_DEFENSE_MARGIN_BNB=0.0005
UNDERCUT_MAX_ACTIVE_OFFERS=10

# v17 execution guardrails
MAX_LIVE_OFFERS_PER_HOUR=10
MAX_BNB_PER_DAY=5.0
SUBMIT_COOLDOWN_SECONDS=30
EXECUTION_RECONCILE_MAX_STALENESS_SECONDS=900

# Optional older sniper config path; kept for compatibility only
SNIPER_CONFIG_PATH=./config/sniper_config.json
