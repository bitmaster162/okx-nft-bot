FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PLAYWRIGHT_BROWSERS_PATH=/app/browsers

WORKDIR /app

RUN useradd --create-home --home-dir /app --shell /usr/sbin/nologin appuser

COPY pyproject.toml README.md ./
COPY src ./src
COPY config ./config
COPY scripts ./scripts

# Install app + playwright + chromium browser
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir playwright && \
    playwright install --with-deps chromium && \
    mkdir -p /app/data && \
    chown -R appuser:appuser /app /app/browsers

USER appuser

HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 CMD ["okx-nft-bot", "sales-stats"]

ENTRYPOINT ["okx-nft-bot"]
CMD ["sales-stream"]
